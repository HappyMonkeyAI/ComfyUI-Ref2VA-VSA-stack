# ComfyUI GPU image (Blackwell / RTX 50-series). Pin a digest in production.
COMFYUI_IMAGE=ghcr.io/pixeloven/comfyui/complete:cuda-sm120-latest

# Path to ComfyUI app root inside the image (pixeloven complete sm120 uses /app).
COMFYUI_HOME=/app

# Host port for ComfyUI web/API
COMFYUI_PORT=8188

# Optional Hugging Face token (leave unset or commented — empty string breaks auth)
# HF_TOKEN=hf_xxxxxxxx

# Defaults for generate / MCP
H3_WIDTH=1344
H3_HEIGHT=768
H3_LENGTH=124
H3_SPARSITY=0.75
H3_TIMEOUT_SEC=900

# ComfyUI URL as seen by host scripts / MCP on the host network
COMFYUI_URL=http://127.0.0.1:8188

# Inside compose network the MCP service uses:
COMFYUI_URL_DOCKER=http://comfyui:8188
